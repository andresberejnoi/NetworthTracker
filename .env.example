# Copy this file to `.env` and change the password.
# `.env` is gitignored and must never be committed.

POSTGRES_USER=networth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=networth

# Image tag. Use a release tag such as v0.1.20261101 for a pinned deployment;
# "latest" is convenient for local builds.
IMAGE_TAG=latest
# Set to 1 to make `make upgrade` pull IMAGE_TAG instead of building locally.
# UPGRADE_PULL=0

# Host ports. Change these if 3000 or 8080 are already in use.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Required for backups. Backups are encrypted with GPG AES-256; use a long,
# unique passphrase and keep a copy somewhere safe. If you lose it, the
# encrypted backups cannot be restored.
BACKUP_PASSPHRASE=change-me
# Backup directory and optional separate log directory for scheduled backups.
# BACKUP_DIR=./backups
# BACKUP_LOG_DIR=./backups
# Number of backups kept by manual/scheduled backups and the entrypoint.
BACKUP_KEEP=14

# "false" enables local login; "true" is single-user offline mode.
AUTH_DISABLED=false

# Compose command for scripts/Makefile. Use "podman compose" or
# "podman-compose" for a pure-Podman setup.
# COMPOSE_CMD=podman compose

# Optional add-ons. Leave unset to keep them inert.
# CHAIN_PROVIDER=fake|public|etherscan
# CHAIN_FAKE_BALANCES=bitcoin:bc1...=0.000000000000000001
# CHAIN_PROVIDER_API_KEY=your-etherscan-key
# PRICE_PROVIDER=coinpaprika
# AGGREGATION_PROVIDER=fake
# AGGREGATION_ENCRYPTION_KEY=<base64 32-byte key>
