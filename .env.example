# Copy this file to `.env` and change the password.
# `.env` is gitignored and must never be committed.

POSTGRES_USER=networth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=networth

# Image tag. Use a release tag such as v0.1.20261110 for a pinned deployment;
# "latest" is convenient for local builds.
IMAGE_TAG=latest
# Set to 1 to make `make upgrade` pull IMAGE_TAG instead of building locally.
# UPGRADE_PULL=0

# Host ports. Change these if 3000 or 8080 are already in use.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Required for backups. Backups are encrypted with GPG AES-256; use a long,
# unique passphrase and keep a copy somewhere safe. If you lose it, the
# encrypted backups cannot be restored.
BACKUP_PASSPHRASE=change-me
# Backup directory and optional separate log directory for scheduled backups.
# BACKUP_DIR=./backups
# BACKUP_LOG_DIR=./backups
# Number of backups kept by manual/scheduled backups and the entrypoint.
BACKUP_KEEP=14
# Optional off-site copy through rclone. Configure the remote with your own
# credentials first (`rclone config`), then set a destination and optional
# remote retention count. The local backup is encrypted before it is copied.
# BACKUP_REMOTE=remote:networth-backups
# BACKUP_REMOTE_KEEP=30

# "false" enables local login; "true" is single-user offline mode.
AUTH_DISABLED=false

# Required to enable encrypted document uploads. Generate a 32-byte key with:
# python3 -c 'import base64,os; print(base64.b64encode(os.urandom(32)).decode())'
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_DIR=./documents
DOCUMENT_MAX_BYTES=20971520

# Optional OpenID Connect SSO. Leave OIDC_ENABLED unset/false for local-only login.
# See docs/sso.md for provider setup and role mapping.
OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.com/application/o/networth/
# OIDC_CLIENT_ID=networth-tracker
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/oidc/callback
# OIDC_FRONTEND_CALLBACK=http://localhost:3000/auth/oidc/callback
# OIDC_SCOPES=openid profile email groups
# OIDC_BUTTON_LABEL=Sign in with Homelab SSO
# OIDC_AUTO_PROVISION=false
# OIDC_DEFAULT_ROLE=viewer
# OIDC_ALLOWED_EMAILS=you@example.com
# OIDC_ALLOWED_SUBJECTS=
# OIDC_ROLE_CLAIM=groups
# OIDC_OWNER_GROUPS=networth-owners
# OIDC_EDITOR_GROUPS=networth-editors

# Compose command for scripts/Makefile. Use "podman compose" or
# "podman-compose" for a pure-Podman setup.
# COMPOSE_CMD=podman compose
# Container command for restore drills when not using the Docker shim.
# DOCKER_CMD=podman

# Optional add-ons. Leave unset to keep them inert.
# CHAIN_PROVIDER=fake|public|etherscan
# CHAIN_FAKE_BALANCES=bitcoin:bc1...=0.000000000000000001
# CHAIN_PROVIDER_API_KEY=your-etherscan-key
# PRICE_PROVIDER=coinpaprika
# AGGREGATION_PROVIDER=fake
# AGGREGATION_ENCRYPTION_KEY=<base64 32-byte key>
